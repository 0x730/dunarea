# Copiați numai pe server la:
# /home/dunarea/dunarea.info/data/keys/offsite-backup.env (0600, owner dunarea).
# Nu sursați fișierul în shell; parserul refuză substituții și configurații
# parțiale. Credentialul Spaces trebuie să fie o cheie readwrite limitată la
# bucketul privat comun, creată distinct pentru Danube.

DANUBE_BACKUP_S3_ENDPOINT=https://fra1.digitaloceanspaces.com
DANUBE_BACKUP_S3_REGION=fra1
DANUBE_BACKUP_S3_BUCKET=existing-private-fleet-backup-space
DANUBE_BACKUP_S3_ACCESS_KEY_ID=replace-with-danube-scoped-access-key
DANUBE_BACKUP_S3_SECRET_ACCESS_KEY=replace-with-secret-shown-once
DANUBE_BACKUP_ENCRYPTION_KEY_FILE=/home/dunarea/dunarea.info/data/keys/danube-backup-encryption.key

# Grup opțional ca întreg. Când există, monitorul și calea de eroare folosesc
# proiectul Scaleway TEM Danube; un grup parțial este refuzat.
DANUBE_BACKUP_TEM_SECRET_KEY=replace-with-danube-tem-secret
DANUBE_BACKUP_TEM_PROJECT_ID=replace-with-danube-tem-project-id
DANUBE_BACKUP_TEM_REGION=fr-par
DANUBE_BACKUP_ALERT_FROM=replace-with-verified-tem-sender@dunarea.info
DANUBE_BACKUP_ALERT_REPLY_TO=daniel@0x730.com
DANUBE_BACKUP_ALERT_TO=daniel@0x730.com
